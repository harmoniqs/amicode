[Unit]
Description=Amicode nightly client shard-divergence watch (amicode#1306 — detection only)
Documentation=https://github.com/harmoniqs/amicode/blob/main/ops/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.amico/ops/shard-watch/run-shard-watch.sh
StandardOutput=append:%h/.amico/ops/shard-watch/systemd.out
StandardError=append:%h/.amico/ops/shard-watch/systemd.err
