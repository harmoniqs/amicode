[Unit]
Description=Amicode session auto-archive — classification-gated nightly curation (amicode#1304)
Documentation=https://github.com/harmoniqs/amicode/blob/main/ops/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.amico/ops/session-archive/run-session-archive.sh --apply
StandardOutput=append:%h/.amico/ops/session-archive/systemd.out
StandardError=append:%h/.amico/ops/session-archive/systemd.err
