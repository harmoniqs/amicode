{
  "name": "@amicode/amico-run",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "amico-run": "./launcher/amico-run",
    "amico": "./launcher/amico",
    "amico-pasqal": "./launcher/amico-pasqal",
    "amico-git-credential": "./launcher/amico-git-credential"
  },
  "amicode": {
    "shadowBins": {
      "gh": "./launcher/gh"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/slow/**'",
    "test:slow": "vitest run --config vitest.slow.config.ts"
  },
  "dependencies": {
    "@amicode/schema": "workspace:*",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
