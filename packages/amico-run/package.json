{
  "name": "@amicode/amico-run",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "amico-run": "./launcher/amico-run"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/slow/**'",
    "test:slow": "vitest run test/slow",
    "demo:harness": "node esbuild.config.mjs && node dist/harness-demo.js"
  },
  "dependencies": {
    "@amicode/schema": "workspace:*",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
