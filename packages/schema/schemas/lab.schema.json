{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amico.harmoniqs.co/schema/lab/v1",
  "title": "amico lab.toml",
  "description": "A partner lab's hardware profile — the only place hardware params enter a solve. Formalizes the Schuster transmon profile the beta template consumes (frequency, anharmonicity, levels, drive cap). Ranged fields give the out-of-range failure class a home (S17).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "qubit"],
  "properties": {
    "schema_version": { "enum": ["1"] },
    "name": { "type": "string", "minLength": 1, "description": "lab/profile identifier" },
    "qubit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency_ghz", "anharmonicity_ghz", "levels", "drive_max_ghz"],
      "properties": {
        "frequency_ghz": { "type": "number", "exclusiveMinimum": 0, "maximum": 100, "description": "qubit transition frequency (GHz)" },
        "anharmonicity_ghz": { "type": "number", "description": "anharmonicity (GHz; positive convention in the beta template)" },
        "levels": { "type": "integer", "minimum": 2, "maximum": 10, "description": "transmon levels modeled (qubit + leakage)" },
        "drive_max_ghz": { "type": "number", "exclusiveMinimum": 0, "maximum": 10, "description": "per-quadrature drive bound (GHz)" }
      }
    }
  }
}
